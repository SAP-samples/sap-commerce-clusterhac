# Folders to ignore, whatever the place they are
*.swp 
*.iml
.metadata
classes
hybris/bin/**/bin
gensrc
addonsrc

.classpath
.classpath.bak
 
# Folders to ignore at the root of the repository
hybris/log/
hybris/temp/
hybris/data/
build-tools/
c4c-integration/
hybris-Mobile-Apps-SDK/
hybris-ems/
hybris-sbg/
installer/
licenses
hybris/config*/config/bin/
 
# filter only custom extension
hybris/bin/*
!hybris/bin/custom/
                
 
# Absolute path to ignore
hybris/config/
 
# Filename patterns to ignore
.DS_Store
*.class
rebel.xml
build.xml
Generated*.java
platformhome.properties
*testclasses.xml
extensioninfo.xsd
*hmc.jar
hmc.xsd
items.xsd
beans.xsd
ruleset.xml
*.log
base.properties
#  Addon specific copy folders
**/_ui/addons
**/views/addons
**/tld/addons
**/tags/addons
**/messages/addons
*_bof.jar

**/web/commonwebsrc

**/.settings/*.prefs
!**/.settings/org.eclipse.core.resources.prefs
!**/.settings/org.eclipse.jdt.core.prefs
!**/.settings/org.eclipse.jdt.ui.prefs

jacocoagent.jar

**/.idea/*
**/eclipsebin/*

# Local toolchain pin (not part of the extension)
.java-version

# Personal reference docs (not shipped)
docs/FEATURES.md
docs/IMPROVEMENTS.md
docs/NAVIGATION-REDESIGN.md
docs/RELEASE-NOTES.md

# Test-only diagnostic scripts (not shipped)
docs/scripts/

# Serena MCP tooling
.serena/
